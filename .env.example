# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.2sucg.mongodb.net/kyra-group-india-dev

# Allowed CORS Origins (comma-separated or * for all)
ALLOWED_ORIGINS=*

# Nodemailer Email Configuration (Gmail App Password)
NODE_MAILER_EMAIL=your-email@gmail.com
NODE_MAILER_PASSWORD=your-app-password
NODE_MAILER_RECEIVER_EMAIL=receiver-email@gmail.com
NODE_MAILER_CC_EMAILS=["cc-email1@gmail.com", "cc-email2@gmail.com"]

# Meta / Facebook Lead Ads Webhook Configuration
FB_VERIFY_TOKEN=kyra_meta_webhook_secret_2026
META_VERIFY_TOKEN=kyra_meta_webhook_secret_2026
META_PAGE_ACCESS_TOKEN=your-page-access-token
META_GRAPH_API_VERSION=v21.0
